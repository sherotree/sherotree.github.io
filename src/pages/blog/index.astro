---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const postsByMonth = new Map<string, typeof posts>();
for (const post of posts) {
  const iso = post.data.date.toISOString().slice(0, 7); // YYYY-MM
  const list = postsByMonth.get(iso);
  if (list) {
    list.push(post);
  } else {
    postsByMonth.set(iso, [post]);
  }
}

function monthHeading(ym: string) {
  const [y, m] = ym.split('-');
  return `${y} 年 ${Number(m)} 月`;
}
---

<BaseLayout title="网络日志" description="全部文章归档，按月份倒序排列。">
  <h1>网络日志</h1>
  {
    posts.length === 0 ? (
      <p class="muted">还没有文章。</p>
    ) : (
      [...postsByMonth.entries()].map(([ym, monthPosts]) => (
        <section>
          <h2 class="year-heading">{monthHeading(ym)}</h2>
          <ul class="post-list">
            {monthPosts.map((post) => (
              <li>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {formatDate(post.data.date)}
                </time>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
