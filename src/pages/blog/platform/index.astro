---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PLATFORMS, PLATFORM_IDS, getPostPlatform } from '../../../consts';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const counts = Object.fromEntries(PLATFORM_IDS.map((id) => [id, 0])) as Record<
  (typeof PLATFORM_IDS)[number],
  number
>;
for (const post of posts) {
  const platform = getPostPlatform(post);
  if (platform) counts[platform] += 1;
}
---

<BaseLayout
  title="分发渠道"
  description="按第三方分发渠道浏览本站母稿：一文归属一个渠道目录，本站统一展示。"
>
  <h1>分发渠道</h1>
  <p class="muted">
    母稿按渠道目录归档（本站 + 对应第三方同步分发）。点进渠道可只看该渠道的文章。
  </p>
  <ul class="entry-links">
    {
      PLATFORM_IDS.map((id) => (
        <li>
          <a href={`/blog/platform/${id}/`}>{PLATFORMS[id].title}</a>
          <span class="desc">
            {PLATFORMS[id].description}（{counts[id]} 篇）
          </span>
        </li>
      ))
    }
  </ul>
  <p class="muted" style="margin-top: 2rem">
    <a href="/blog/">← 返回全部网络日志</a>
  </p>
</BaseLayout>
