---
import BaseLayout from './BaseLayout.astro';
import { SITE_URL, AUTHOR, GITHUB_URL, SERIES, formatDate } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, updated, description, tags, series } = post.data;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'zh-CN',
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  author: { '@type': 'Person', name: AUTHOR, url: GITHUB_URL },
  isPartOf: { '@id': `${SITE_URL}/#website` },
  ...(tags.length > 0 && { keywords: tags.join(',') }),
};
---

<BaseLayout title={title} description={description}>
  <article>
    <h1>{title}</h1>
    <p class="post-meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      {updated && <span> · 更新于 {formatDate(updated)}</span>}
      {
        series && SERIES[series] && (
          <span>
            {' · 系列：'}
            <a href={`/series/${series}/`}>{SERIES[series].title}</a>
          </span>
        )
      }
      {tags.length > 0 && <span> · {tags.join(' / ')}</span>}
    </p>
    <slot />
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
</BaseLayout>
