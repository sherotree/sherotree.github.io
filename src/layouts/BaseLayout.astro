---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, GITHUB_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: `${SITE_URL}/`,
  inLanguage: 'zh-CN',
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="msvalidate.01" content="F5D467141247B94C2F2AC4E99507FB1A" />
    <meta name="google-site-verification" content="QvxdnsG_OtYP2F8mGkseLy1KXvMsfirDdfoq_jwmrV4" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a class="site-name" href="/">{SITE_TITLE}</a>
        <nav>
          <a href="/blog/">网络日志</a>
          <a href="/about/">关于</a>
          <a href={GITHUB_URL}>GitHub</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} sherotree · 把复杂技术讲清楚</p>
      </footer>
    </div>
  </body>
</html>
