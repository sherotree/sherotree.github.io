---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  const list = postsByYear.get(year);
  if (list) {
    list.push(post);
  } else {
    postsByYear.set(year, [post]);
  }
}
---

<BaseLayout title="网络日志" description="全部文章归档，按日期倒序排列。">
  <h1>网络日志</h1>
  {
    posts.length === 0 ? (
      <p class="muted">还没有文章。</p>
    ) : (
      [...postsByYear.entries()].map(([year, yearPosts]) => (
        <section>
          <h2 class="year-heading">{year} 年</h2>
          <ul class="post-list">
            {yearPosts.map((post) => (
              <li>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {formatDate(post.data.date)}
                </time>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
